# Copy this file to .env and fill in the values before running the app

# Required: a long random string used to sign session cookies
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Optional: SQLite database path (default used if not set)
DATABASE_URL=sqlite:///./securevault.db

# Deployment environment — controls https_only on the session cookie.
# Set to "development" for local dev (allows http:// cookies).
# Omit or set to "production" for any deployed instance (cookie requires HTTPS).
ENVIRONMENT=production

# Optional: session inactivity timeout in minutes (default: 10)
SESSION_TIMEOUT_MINUTES=10
