# Virtual environment
venv/
.venv/
env/

# Environment variables — never commit real secrets
.env

# Python cache
__pycache__/
*.py[cod]
*.pyo

# SQLite database — contains user data
*.db
*.sqlite3

# Pytest cache and coverage
.pytest_cache/
.coverage
htmlcov/

# Alembic — only ignore the compiled cache, not migration scripts
app/migrations/__pycache__/

# macOS
.DS_Store

# IDEs
.vscode/
.idea/
*.swp

# Claude Code personal settings
.claude/settings.local.json

# Claude auto-memory (personal, not team)
.claude/memory/
